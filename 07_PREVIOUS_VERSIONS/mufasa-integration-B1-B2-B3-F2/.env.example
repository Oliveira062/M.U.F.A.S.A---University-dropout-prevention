# Copy to .env and fill in. The .env NEVER goes to the repository.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"

# The API connects with the least-privilege role, never with postgres.
DATABASE_URL=postgresql+psycopg://mufasa_api:CHANGE_HERE@localhost:5432/mufasa

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# development | production
ENVIRONMENT=development
FORCE_HTTPS=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Dashboard address (F1). Empty turns CORS off.
CORS_ORIGINS=[]
DOCS_ENABLED=true

# Current minimum wage in reais, for the financial factor. Confirm the value for the year.
MINIMUM_WAGE=

# ---------------------------------------------------------------------------
# Chatbot (F2)
# ---------------------------------------------------------------------------
# Database role only for the chatbot (sql/chatbot.sql). Required in production.
CHAT_DATABASE_URL=postgresql+psycopg://mufasa_chat:CHANGE_HERE@localhost:5432/mufasa

# Groq (optional). Empty = answers with the ready-made texts, no external service.
# The key belongs to the project account: never in code, zip or message.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Classify with the AI the questions the rules do not recognize (sends the redacted
# text, without names, numbers and contacts). Leave false if there is no need.
CHAT_AI_CLASSIFY=false

# Text that completes "support with a person from the staff happens ..." (RF13)
CHAT_SERVICE_WINDOW=during the academic registrar's office hours
